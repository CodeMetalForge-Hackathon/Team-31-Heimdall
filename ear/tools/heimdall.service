# Heimdall Ear. Install (don't enable until demo day):
#   sudo cp ~/Team-31/ear/tools/heimdall.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl start heimdall      # run now
#   sudo systemctl enable heimdall     # start on boot (later)
#   journalctl -u heimdall -f          # logs
[Unit]
Description=Heimdall Ear (station server)
After=network-online.target NetworkManager.service
Wants=network-online.target

[Service]
User=heimdall
Group=heimdall
SupplementaryGroups=i2c spi gpio dialout video audio plugdev
WorkingDirectory=/home/heimdall/Team-31
Environment=PYTHONUNBUFFERED=1
# Environment=HEIMDALL_MODULES=mock
ExecStart=/home/heimdall/heimdall-venv/bin/python -m ear.main
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
